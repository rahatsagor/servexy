{
	"name": "servexy",
	"version": "1.3.0",
	"description": "Fast production-ready static file server with reliable SPA routing.",
	"bin": {
		"servexy": "bin/servexy"
	},
	"scripts": {
		"build": "bun run build:binaries",
		"build:binaries": "bun scripts/build-binaries.js",
		"build:current": "bun scripts/build-binaries.js --current",
		"check": "bun run test && bun run vet",
		"test": "go test ./...",
		"test:race": "go test -race ./...",
		"test:launcher": "bun scripts/test-launcher.js",
		"vet": "go vet ./...",
		"vuln": "go run golang.org/x/vuln/cmd/govulncheck@v1.8.0 ./...",
		"verify:current": "bun scripts/verify-package.js --current",
		"prepack": "bun scripts/verify-package.js"
	},
	"keywords": [
		"http-server",
		"file-server",
		"static-server",
		"zero-config",
		"development",
		"cli",
		"go",
		"binary",
		"serve",
		"static",
		"local-server",
		"spa",
		"vue",
		"vite",
		"react",
		"history-fallback",
		"gzip",
		"cache-control"
	],
	"author": "Rahat Sagor",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rahatsagor/servexy.git"
	},
	"homepage": "https://github.com/rahatsagor/servexy#readme",
	"bugs": {
		"url": "https://github.com/rahatsagor/servexy/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=18.0.0"
	},
	"os": [
		"darwin",
		"linux",
		"win32"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"files": [
		"bin/servexy",
		"dist/servexy-*",
		"dist/SHA256SUMS",
		"README.md",
		"LICENSE"
	]
}
