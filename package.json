{
	"name": "servexy",
	"version": "1.1.0",
	"description": "Fast zero-config static file server with optional SPA history fallback.",
	"bin": {
		"servexy": "bin/servexy"
	},
	"scripts": {
		"build": "bun run build:binaries",
		"build:binaries": "bun scripts/build-binaries.js",
		"build:current": "bun scripts/build-binaries.js --current",
		"test": "go test ./...",
		"prepack": "bun scripts/verify-package.js"
	},
	"keywords": [
		"http-server",
		"file-server",
		"static-server",
		"zero-config",
		"development",
		"cli",
		"go",
		"binary",
		"serve",
		"static",
		"local-server",
		"spa",
		"vue",
		"vite",
		"react",
		"history-fallback"
	],
	"author": "Rahat Sagor",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rahatsagor/servexy.git"
	},
	"homepage": "https://github.com/rahatsagor/servexy#readme",
	"bugs": {
		"url": "https://github.com/rahatsagor/servexy/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=18.0.0"
	},
	"os": [
		"darwin",
		"linux",
		"win32"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"files": [
		"bin/servexy",
		"dist/servexy-*",
		"README.md",
		"LICENSE"
	]
}
